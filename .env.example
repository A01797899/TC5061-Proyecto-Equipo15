# Plantilla sin secretos. Copiar a .env (no versionado) solo si el servidor no es el local.
# No poner contraseñas, tokens ni claves en este archivo.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Semana 10 - Compose: puertos publicados en localhost para la API y MLflow.
API_PORT=8000
MLFLOW_PORT=5000
# Dentro de Compose la API usa http://mlflow:5000; se fija en docker-compose.yml.
