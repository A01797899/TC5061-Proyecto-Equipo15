# Imagen del servidor MLflow (Tracking + Model Registry); los datos se montan como volumen.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /mlflow

# Uso la misma versión de MLflow que registró el Champion P1.
RUN python -m pip install --no-cache-dir mlflow==3.16.1

EXPOSE 5000
